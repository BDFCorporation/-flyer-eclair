# Base de données PostgreSQL (Neon, Supabase, ou instance locale)
DATABASE_URL="postgresql://user:password@localhost:5432/parfums_site"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend (e-mails transactionnels)
RESEND_API_KEY="re_..."
EMAIL_FROM="commandes@ton-domaine.fr"
CONTACT_EMAIL="contact@ton-domaine.fr"

# Auth
AUTH_SECRET="change-moi-en-chaine-aleatoire-longue"

# URL publique du site (utilisée pour le sitemap, les liens e-mail, Stripe redirect)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Frais de port fixes (en centimes)
SHIPPING_FLAT_RATE_CENTS="490"

# Compte admin créé automatiquement par `npm run db:seed` (à changer après premier login)
ADMIN_EMAIL="admin@ton-domaine.fr"
ADMIN_PASSWORD="change-moi"

# Assistant IA (chatbot) — clé API Anthropic
ANTHROPIC_API_KEY="sk-ant-..."
